---
// セクション20: faq (Figma 113:3197)
// 白背景 / アコーディオンFAQ（details/summary。SP Figma 1:1880 の開いた状態を再現）

// 回答文は SP の faq_open (Figma 1:1880) から転記。配列の1要素が1段落（改行位置はカンプどおり）
const faqItems = [
  { q: '利用料金について教えてください。', a: ['SUISOPOT（スイソポット）のご利用には以下の料金がかかります。', '月額利用料：3,800円（税込）', '初期手数料：5,000円（税込）', '送料：無料', '上記以外の料金は一切かかりません。'] },
  { q: '申し込んでから、いつ届きますか？', a: ['最短でお申し込み日の1～3営業日以内の出荷となります。', '配送地域や交通状況によりお届けが遅れる場合もございます。'] },
  { q: '支払い方法には何がありますか？', a: ['下記の2つからお選びいただけます。', '・クレジットカード', '（VISA/JCB/Master Card）', '・銀行口座引落し'] },
  { q: '更新日はどのようなサイクルになりますか？', a: ['お申込日を起算日として、毎月お申込日と同じ日付が更新日となります。', '（例：1月23日申込の場合、次回更新が2月23日となります。）'] },
  { q: '途中で解約したいのですが費用はかかりますか？', a: ['解約手数料は不要です。', '解約ご希望日の1ヶ月前迄に解約申請をお願いします。'] },
  { q: 'マイクロバブルとナノバブルの違いは？', a: ['マイクロバブルとは直径約1～50µm以下の小さな泡のことで、ナノバブルは0.1µm以下の目に見えない超微細な泡となります。マイクロバブルはすぐに弾けて消えてしまいますが、ナノバブルは1ヶ月以上も泡のまま残留できるといった特徴があります。'] },
  { q: 'ナノバブルはなぜカラダにいいの？', a: ['ナノバブル水素水は浸透力に優れ、カラダのすみずみまでナノバブル水素と酸素を届けます。また、通常のお水は酸化しているのに対して、SUISOPOTで生成したナノバブル水素水は抗酸化力が高く、カラダの酸化を防ぎます。'] },
  { q: 'タンクの容量はどのくらいですか？', a: ['タンク容量は5リットルです。', 'コップ約25杯分を作ることができますので、たっぷりお使いいただけます。'] },
  { q: '本当に使い放題ですか？', a: ['はい、水道水を注ぐだけでお好きなだけご利用いただけます。'] },
  { q: 'お手入れは必要ですか？', a: ['フィルター交換は不要です。グランド電極にイオン化したミネラルが付着する場合がありますので、その際はポット洗浄剤やクエン酸で洗浄してください。また、付属のミネラルプレートも定期的に洗浄してください。詳しくは取扱説明書をご覧ください。また使用方法、お手入れ方法の動画でもご確認いただけます。'] },
  { q: '衛生面が気になります。', a: ['タンク内は定期的に清掃いただくことをおすすめします。', '生成されたナノバブル水素水は、2日以内にお飲みください。'] },
  { q: 'ミネラルプレートの交換サイクルは？', a: ['ミネラルプレート1セットの交換サイクルは6ヶ月となり、製品お届け時は1年分（2セット）が同封されております。その後ご契約から1年経過毎に1年分（2セット）を無料にてお届けしますので、お客様ご自身でご交換をお願いします。'] },
  { q: 'どんな味ですか？', a: ['付属のミネラルプレートからミネラルが微量に溶け出し、まろやかで角のとれた飲みやすい味です。'] },
  { q: '病気や妊婦さんでも飲めますか？', a: ['問題ありませんので、安心してお飲みください。ご心配な方はかかりつけのお医者様にご相談ください。'] },
  { q: '毎日どのくらい飲めばよいのでしょうか？', a: ['特に決まりはありませんが、一般的に1日 1.5～2ℓの水分補給が健康に良いと言われております。'] },
  { q: '飲み水以外で使っても平気ですか？', a: ['はい、料理やコーヒー、紅茶、お酒の割り水、ペットの飲料水、生け花のお水、野菜の洗浄など様々な場面でご使用いただけます。'] },
];
---

<section class="sp-faq" id="faq">

  <div class="sp-faq__title-wrap sp-fade">
    <img class="sp-faq__title-deco" src="/mock_site/suisopot/images/title-deco-left.webp" alt="" aria-hidden="true" width="33" height="53" loading="lazy" />
    <h2 class="sp-faq__title">よくある質問</h2>
    <img class="sp-faq__title-deco" src="/mock_site/suisopot/images/title-deco-right.webp" alt="" aria-hidden="true" width="33" height="53" loading="lazy" />
  </div>

  <div class="sp-faq__list sp-fade">
    {faqItems.map((item) => (
      <details class="sp-faq__item">
        <summary class="sp-faq__question">
          <span class="sp-faq__badge" aria-hidden="true">
            <img src="/mock_site/suisopot/images/faq-qicon.svg" alt="" width="33" height="33" />
            <span class="sp-faq__badge-letter sp-faq__badge-letter--q">Q</span>
          </span>
          <span class="sp-faq__q-text">{item.q}</span>
          <img class="sp-faq__arrow" src="/mock_site/suisopot/images/faq-arrow.svg" alt="" aria-hidden="true" width="24" height="24" />
        </summary>
        <div class="sp-faq__answer">
          <span class="sp-faq__badge" aria-hidden="true">
            <img src="/mock_site/suisopot/images/faq-aicon.svg" alt="" width="25" height="25" />
            <span class="sp-faq__badge-letter sp-faq__badge-letter--a">A</span>
          </span>
          <div class="sp-faq__a-text">
            {item.a.map((line) => <p>{line}</p>)}
          </div>
        </div>
      </details>
    ))}
  </div>

</section>
