---
// セクション7: cta② (Figma 113:2827 / SP 1:2545)
// 構成: 上部波形 → 水色パネル（タイトル・2つのCTAボタン）→ 右に製品画像（パネル下端からはみ出す）
---

<section class="sp-cta-second" id="cta-second" aria-label="お申し込みのご案内">
  <picture>
    <source media="(max-width: 767px)" srcset="/mock_site/suisopot/images/cta2-wave-sp.svg" width="390" height="16" />
    <img class="sp-cta-second__wave" src="/mock_site/suisopot/images/cta2-wave.svg" alt="" aria-hidden="true" width="1440" height="50" loading="lazy" />
  </picture>

  <div class="sp-cta-second__panel">
    <div class="sp-cta-second__inner sp-fade">
      <h2 class="sp-cta-second__title">
        <img class="sp-cta-second__title-deco" src="/mock_site/suisopot/images/title-deco-left.webp" alt="" aria-hidden="true" width="33" height="53" loading="lazy" />
        <span class="sp-cta-second__title-text">さっそく<strong>ナノバブル水素水</strong>の<br class="sp-only" />ある生活を始めてみましょう</span>
        <img class="sp-cta-second__title-deco" src="/mock_site/suisopot/images/title-deco-right.webp" alt="" aria-hidden="true" width="33" height="53" loading="lazy" />
      </h2>

      <ul class="sp-cta-second__btn-list">
        <li class="sp-cta-second__btn-item">
          <p class="sp-cta-second__btn-lead">
            <img class="sp-cta-second__slash sp-cta-second__slash--left" src="/mock_site/suisopot/images/cta1-deco-left.svg" alt="" aria-hidden="true" width="22" height="2" loading="lazy" />
            簡単入力３分で完了！
            <img class="sp-cta-second__slash sp-cta-second__slash--right" src="/mock_site/suisopot/images/cta1-deco-right.svg" alt="" aria-hidden="true" width="22" height="2" loading="lazy" />
          </p>
          <a href="#" class="sp-cta-second__btn">
            <span class="sp-cta-second__btn-text"><strong>無料</strong>で<strong>資料請求</strong>をする</span>
            <span class="sp-cta-second__btn-arrow" aria-hidden="true"><img src="/mock_site/suisopot/images/cta-btn-arrow.svg" alt="" aria-hidden="true" width="21" height="11" loading="lazy" /></span>
          </a>
        </li>
        <li class="sp-cta-second__btn-item">
          <p class="sp-cta-second__btn-lead">
            <img class="sp-cta-second__slash sp-cta-second__slash--left" src="/mock_site/suisopot/images/cta1-deco-left.svg" alt="" aria-hidden="true" width="22" height="2" loading="lazy" />
            最短翌日発送！
            <img class="sp-cta-second__slash sp-cta-second__slash--right" src="/mock_site/suisopot/images/cta1-deco-right.svg" alt="" aria-hidden="true" width="22" height="2" loading="lazy" />
          </p>
          <a href="#" class="sp-cta-second__btn">
            <span class="sp-cta-second__btn-text sp-cta-second__btn-text--plain">新規お申込</span>
            <span class="sp-cta-second__btn-arrow" aria-hidden="true"><img src="/mock_site/suisopot/images/cta-btn-arrow.svg" alt="" aria-hidden="true" width="21" height="11" loading="lazy" /></span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <img class="sp-cta-second__product" src="/mock_site/suisopot/images/fv-product.webp" alt="SUISOPOT 水素水サーバー本体" width="346" height="606" loading="lazy" />
</section>
