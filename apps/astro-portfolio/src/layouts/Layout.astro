---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Web Engineer</title>
    <meta
      name="description"
      content="デザインの立案から公開・運用まで一貫して対応するWebエンジニア。Figmaデザインの再現、WordPress・ヘッドレスCMSの構築、AIを使った開発、内部SEO対策まで、確かな技術で形にします。"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="canonical"
      href="https://astro-portfolio-sigma-seven.vercel.app"
    />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta
      property="og:title"
      content="Hiroyuki Chuman | Web Engineer | Astro・React・TypeScript"
    />
    <meta
      property="og:description"
      content="デザインの立案から公開・運用まで一貫して対応するWebエンジニア。Figmaデザインの再現、WordPress・ヘッドレスCMSの構築、AIを使った開発、内部SEO対策まで、確かな技術で形にします。"
    />
    <meta
      property="og:image"
      content="https://astro-portfolio-sigma-seven.vercel.app/ogp.webp"
    />
    <meta
      property="og:url"
      content="https://astro-portfolio-sigma-seven.vercel.app"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hiroyuki Chuman Portfolio" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Hiroyuki Chuman",
        "url": "https://astro-portfolio-sigma-seven.vercel.app",
        "image": "https://astro-portfolio-sigma-seven.vercel.app/ogp.webp",
        "sameAs": ["https://github.com/koenjineer"],
        "jobTitle": "Web Engineer",
        "description": "デザインの立案から公開・運用まで一貫して対応するWebエンジニア。"
      }
    </script>

    <!--
      スクロールで浮かび上がる演出の準備。描画の前に印を付けて、一瞬見えてから消える「ちらつき」を防ぐ。
      JSが動かない環境・「動きを減らす」設定では印が付かず、最初から全部見える
    -->
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("reveal-ready");
      }
      // ナビの切り替えボタンで選んだ見た目を、描画の前に反映する（一瞬ライトで出る「ちらつき」を防ぐ）
      try {
        const savedTheme = localStorage.getItem("theme");
        if (savedTheme === "light" || savedTheme === "dark") {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch {
        // 保存領域が使えない環境では、端末の外観設定に合わせる
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
    <script>
      // data-reveal の要素が画面の下10%より内側に入ったら、一度だけ表示する
      const REVEAL_ROOT_MARGIN = "0px 0px -10% 0px";

      if (document.documentElement.classList.contains("reveal-ready")) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-revealed");
              revealObserver.unobserve(entry.target);
            }
          },
          { rootMargin: REVEAL_ROOT_MARGIN },
        );
        document
          .querySelectorAll("[data-reveal]")
          .forEach((target) => revealObserver.observe(target));
      }
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #f8f9fa;
    --sec: #3b82f6;
    --white: #1a1a2e;
    --white-icon: #1a1a2e99;
    --white-icon-tr: #1a1a2e15;
    --component-bg: #ffffff;
    --nav-border: rgba(26, 26, 46, 0.1);
    --logo-ink: #1a1a1a;
    color-scheme: light dark;
  }

  /*
    ダークモード：端末の外観設定に合わせて変数だけを差し替える。
    data-theme は今は付けていない。将来の切り替えボタンは、<html> に
    data-theme="light" / "dark" を付け外しするだけで済むように、両方の書き方にしてある
  */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --background: #0f1117;
      --white: #e8e9ee;
      --white-icon: #e8e9ee99;
      --white-icon-tr: #e8e9ee1a;
      --component-bg: #181b24;
      --nav-border: #e8e9ee1a;
      --logo-ink: #e8e9ee;
    }
  }

  :root[data-theme="light"] {
    color-scheme: light;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --background: #0f1117;
    --white: #e8e9ee;
    --white-icon: #e8e9ee99;
    --white-icon-tr: #e8e9ee1a;
    --component-bg: #181b24;
    --nav-border: #e8e9ee1a;
    --logo-ink: #e8e9ee;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  /* スクロールで浮かび上がる演出（印の付け方は <head> と <body> 末尾のスクリプト） */
  @media (prefers-reduced-motion: no-preference) {
    html.reveal-ready [data-reveal] {
      opacity: 0;
      transform: translateY(24px);
      transition:
        opacity 0.6s ease-out,
        transform 0.6s ease-out;
      transition-delay: var(--reveal-delay, 0s);
    }

    html.reveal-ready [data-reveal].is-revealed {
      opacity: 1;
      transform: none;
    }
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>
