---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Web Engineer</title>
    <meta
      name="description"
      content="デザインの立案から公開・運用まで一貫して対応するWebエンジニア。Figmaデザインの再現、WordPress・ヘッドレスCMSの構築、AIを使った開発、内部SEO対策まで、確かな技術で形にします。"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="canonical"
      href="https://astro-portfolio-sigma-seven.vercel.app"
    />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta
      property="og:title"
      content="Hiroyuki Chuman | Web Engineer | Astro・React・TypeScript"
    />
    <meta
      property="og:description"
      content="デザインの立案から公開・運用まで一貫して対応するWebエンジニア。Figmaデザインの再現、WordPress・ヘッドレスCMSの構築、AIを使った開発、内部SEO対策まで、確かな技術で形にします。"
    />
    <meta
      property="og:image"
      content="https://astro-portfolio-sigma-seven.vercel.app/ogp.webp"
    />
    <meta
      property="og:url"
      content="https://astro-portfolio-sigma-seven.vercel.app"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hiroyuki Chuman Portfolio" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Hiroyuki Chuman",
        "url": "https://astro-portfolio-sigma-seven.vercel.app",
        "image": "https://astro-portfolio-sigma-seven.vercel.app/ogp.webp",
        "sameAs": ["https://github.com/koenjineer"],
        "jobTitle": "Web Engineer",
        "description": "デザインの立案から公開・運用まで一貫して対応するWebエンジニア。"
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #f8f9fa;
    --sec: #3b82f6;
    --white: #1a1a2e;
    --white-icon: #1a1a2e99;
    --white-icon-tr: #1a1a2e15;
    --component-bg: #ffffff;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>
