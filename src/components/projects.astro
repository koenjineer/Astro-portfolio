---
import { Image } from "astro:assets";
import ohaImage from "../../public/oha.webp";
import ravek from "../../public/ravek.webp";
import gardensalad from "../../public/gardensalad.webp";
import meliafitness from "../../public/meliafitness.webp";

interface Project {
  title: string;
  image: ImageMetadata;
  link: string;
  preview: string;
  status: string;
  intent: string;
  tech: string[];
}

const projects: Project[] = [
  {
    title: "Ravek",
    image: ravek as ImageMetadata,
    link: "",
    preview: "/mock_site/webservice/",
    status: "架空サイト",
    intent: "BtoB SaaSを想定したWebサービスLP。信頼感と機能訴求を両立するレイアウト構成を目指しました。",
    tech: ["Astro", "SCSS", "JavaScript"],
  },
  {
    title: "Garden Salad",
    image: gardensalad as ImageMetadata,
    link: "",
    preview: "/mock_site/GardenSalad/",
    status: "架空サイト",
    intent: "飲食店向けブランドサイト。写真の迫力を活かしたフルスクリーンレイアウトで食欲を刺激するデザインを目指しました。",
    tech: ["Astro", "SCSS", "JavaScript"],
  },
  {
    title: "OHA!",
    image: ohaImage as ImageMetadata,
    link: "",
    preview: "/mock_site/oha/",
    status: "架空サイト",
    intent: "目覚まし×マッチングをテーマにしたアプリLP。ユーザーの共感を引き出すコピーと直感的なCTAを意識して設計しました。",
    tech: ["HTML", "SCSS", "JavaScript"],
  },
  {
    title: "MELIA FITNESS",
    image: meliafitness as ImageMetadata,
    link: "",
    preview: "/mock_site/MELIAFITNESS/",
    status: "架空サイト",
    intent: "パーソナルトレーニングジムのLP。高級感と説得力を意識したビジュアル構成で、入会への導線を強く設計しました。",
    tech: ["Astro", "SCSS", "JavaScript"],
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[var(--white-icon-tr)] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">実績</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">制作実績</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <div class="project-card group">
            <div class="project-img-area rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 mb-4 relative cursor-pointer">
              <Image
                src={project.image}
                alt={project.title}
                class="project-img w-full h-48 md:h-72 object-cover"
              />
              <div class="project-overlay absolute inset-0 bg-black/70 opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-6 flex flex-col justify-end">
                <p class="text-xs text-white/60 uppercase tracking-wider mb-1">制作意図</p>
                <p class="text-white text-sm leading-relaxed mb-4">{project.intent}</p>
                <p class="text-xs text-white/60 uppercase tracking-wider mb-2">使用技術</p>
                <div class="flex flex-wrap gap-2">
                  {project.tech.map((t) => (
                    <span class="text-xs bg-white/20 text-white px-2 py-1 rounded-full">{t}</span>
                  ))}
                </div>
              </div>
            </div>
            <div class="flex items-center px-3">
              <div class="flex-grow">
                <h4 class="text-2xl font-semibold">{project.title}</h4>
                <span class="py-1 text-sm text-[var(--white-icon)]">
                  {project.status}
                </span>
              </div>
              <div class="flex gap-2 ml-auto">
                <a
                  target="_blank"
                  href={project.preview}
                  rel="noopener noreferrer"
                  aria-label="Preview"
                  class="project-link size-14 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-white hover:bg-[var(--white-icon-tr)]"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="size-7"
                  >
                    <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .project-card.is-active .project-overlay {
    opacity: 1;
  }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>(".project-card");
  const hasHover = window.matchMedia("(hover: hover)").matches;

  if (!hasHover) {
    cards.forEach((card) => {
      const imgArea = card.querySelector<HTMLElement>(".project-img-area");

      imgArea?.addEventListener("click", () => {
        const isActive = card.classList.contains("is-active");
        cards.forEach((c) => c.classList.remove("is-active"));
        if (!isActive) card.classList.add("is-active");
      });
    });

    document.addEventListener("click", (e) => {
      if (!(e.target as HTMLElement).closest(".project-card")) {
        cards.forEach((c) => c.classList.remove("is-active"));
      }
    });
  }
</script>
