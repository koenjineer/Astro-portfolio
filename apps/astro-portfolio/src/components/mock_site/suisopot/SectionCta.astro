---
// セクション3: cta① (Figma 113:2227 / SP 1:2913) / セクション14: cta③ (Figma 123:3772 / SP 135:2493)
// 共通コンポーネント - props で文言を切替。Figma が絶対配置のため、カード内は固定寸法で再現する
export interface Props {
  id?: string;
  heading?: string;
  highlight?: string;
  note?: string;
  btnLabel?: string;
  href?: string;
  imageSrc?: string;
}

const {
  id = 'cta',
  heading = 'お得にはじめるチャンス',
  highlight = '初期手数料',
  note = '初期手数料(5,000円)が無料になります',
  btnLabel = '資料請求する',
  href = '#',
  imageSrc = '/mock_site/suisopot/images/fv-product.webp',
} = Astro.props as Props;
---

<section class="sp-cta" id={id} aria-label="キャンペーンのご案内">
  <div class="sp-cta__card sp-fade">
    <img class="sp-cta__product" src={imageSrc} alt="SUISOPOT 水素水サーバー本体" width="346" height="606" loading="lazy" decoding="async" />

    <h2 class="sp-cta__heading">
      <img class="sp-cta__heading-deco sp-cta__heading-deco--left" src="/mock_site/suisopot/images/cta1-deco-left.svg" alt="" aria-hidden="true" width="22" height="2" loading="lazy" />
      <span>{heading}</span>
      <img class="sp-cta__heading-deco sp-cta__heading-deco--right" src="/mock_site/suisopot/images/cta1-deco-right.svg" alt="" aria-hidden="true" width="22" height="2" loading="lazy" />
    </h2>

    <div class="sp-cta__price">
      <div class="sp-cta__price-label-wrap">
        <img class="sp-cta__dots" src="/mock_site/suisopot/images/cta-dots.svg" alt="" aria-hidden="true" width="167" height="7" loading="lazy" />
        <span class="sp-cta__price-label">{highlight}</span>
      </div>
      <span class="sp-cta__price-em">無料</span>
    </div>
    <img class="sp-cta__line" src="/mock_site/suisopot/images/cta-dashed-line.svg" alt="" aria-hidden="true" width="360" height="2" loading="lazy" />
    <p class="sp-cta__campaign">キャンペーン実施中</p>

    <p class="sp-cta__note">{note}</p>

    <a href={href} class="sp-cta__btn">
      <span class="sp-cta__btn-label">{btnLabel}</span>
      <span class="sp-cta__btn-arrow" aria-hidden="true">
        <img src="/mock_site/suisopot/images/cta-btn-arrow.svg" alt="" aria-hidden="true" width="20" height="11" loading="lazy" />
      </span>
    </a>
  </div>
</section>
