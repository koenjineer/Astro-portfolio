---
---

<section class="gs-mv" aria-label="メインビジュアル">
  <!-- 背景画像（右 75% 領域） -->
  <div class="gs-mv__img-wrap">
    <img
      src="/mock_site/GardenSalad/images/mv.webp"
      alt="TF Garden Saladのサラダ"
      class="gs-mv__img"
      loading="eager"
      width="2160"
      height="1300"
    />
  </div>

  <!-- キャッチコピー -->
  <div class="gs-mv__copy">
    <!-- 英語（3行） -->
    <div class="gs-mv__en">
      <!-- 1行目: Let's eat -->
      <p>Let's eat</p>
      <!-- 2行目: delicious -->
      <p>delicious</p>
      <!-- 3行目: salad. （salad はグリーン） -->
      <p><span class="gs-mv__en-salad">salad</span>.</p>
    </div>

    <!-- 日本語 -->
    <div class="gs-mv__ja">
      <p class="gs-mv__ja-line1">健康のためじゃない、</p>
      <div class="gs-mv__ja-bar">
        <p class="gs-mv__ja-line2">「おいしいから食べたい」サラダ</p>
      </div>
    </div>
  </div>

</section>
