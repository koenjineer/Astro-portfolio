---
// セクション4: onayami (Figma 113:2255 / SP 44:2826)
// SP の3つ目だけ Figma で2行に折り返しているため、tail を SP 限定の改行で続ける
const items = [
  { text: '手軽に健康を手に入れたい' },
  { text: 'そろそろお水にもこだわりたい' },
  { text: '腸活何からしたら良いか', tail: 'わからない' },
];
---

<section class="sp-onayami" id="onayami">
  <div class="sp-onayami__bg" aria-hidden="true"></div>

  <div class="sp-onayami__inner">
    <h2 class="sp-onayami__title sp-fade">こんなお悩みありませんか?</h2>

    <div class="sp-onayami__main">
      <picture class="sp-onayami__visual sp-fade">
        <source media="(max-width: 767px)" srcset="/mock_site/suisopot/images/onayami-sp.webp" width="163" height="240" />
        <img src="/mock_site/suisopot/images/onayami.webp" alt="悩む女性" width="368" height="367" loading="lazy" decoding="async" />
      </picture>

      <ul class="sp-onayami__list">
        {
          items.map((item) => (
            <li class="sp-onayami__item sp-fade">
              <img class="sp-onayami__check" src="/mock_site/suisopot/images/onayami-checkbox.svg" alt="" aria-hidden="true" width="24" height="24" loading="lazy" />
              <span class="sp-onayami__text">{item.text}{item.tail && <><br class="sp-only" />{item.tail}</>}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <p class="sp-onayami__message">それに<span class="sp-onayami__comma">、</span>活性酸素が増えると<span class="sp-onayami__comma">、</span>様々な影響が…</p>
</section>
