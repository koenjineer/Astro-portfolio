<section class="mf-access" id="access" aria-labelledby="mf-access-title">
  <h2 class="mf-access__title mf-section-title mf-reveal" id="mf-access-title">
    <span class="mf-section-title__en">ACCESS</span>
    <span class="mf-section-title__line" aria-hidden="true"></span>
    <span class="mf-section-title__jp">アクセス</span>
  </h2>

  <div class="mf-access__body">
    <!-- Info -->
    <div class="mf-access__info mf-reveal">
      <h3 class="mf-access__name">MELIA FITNESS</h3>
      <p class="mf-access__sub-name">パーソナルトレーニングジム メリアフィットネス</p>
      <div class="mf-access__detail">
        <p>〒170-6045<br />東京都豊島区東池袋3-1-1 サンシャイン60 45階</p>
        <p>JR池袋駅より徒歩５分</p>
        <p>TEL 00-0000-0000</p>
        <p>営業時間 10：00～22：00</p>
      </div>
    </div>

    <!-- Map -->
    <div class="mf-access__map mf-reveal">
      <picture>
        <source
          media="(max-width: 767px)"
          srcset="/mock_site/MELIAFITNESS/images/map-sp.webp"
        />
        <img
          src="/mock_site/MELIAFITNESS/images/map.webp"
          alt="MELIA FITNESSへのアクセスマップ"
          loading="lazy"
        />
      </picture>
    </div>
  </div>
</section>
