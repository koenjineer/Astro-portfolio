---
---

<section class="mf-mv" aria-label="メインビジュアル">
  <!-- Background image -->
  <div class="mf-mv__bg">
    <picture>
      <source
        media="(max-width: 767px)"
        srcset="/mock_site/MELIAFITNESS/images/mv-bg-sp.webp"
      />
      <img
        src="/mock_site/MELIAFITNESS/images/mv-bg.webp"
        alt=""
        loading="eager"
        aria-hidden="true"
      />
    </picture>
  </div>

  <!-- Woman photo -->
  <div class="mf-mv__woman">
    <picture>
      <source
        media="(max-width: 767px)"
        srcset="/mock_site/MELIAFITNESS/images/mv-woman-sp.webp"
      />
      <img
        src="/mock_site/MELIAFITNESS/images/mv-woman.webp"
        alt="トレーニング中の女性"
        loading="eager"
      />
    </picture>
  </div>

  <!-- Overlay -->
  <div class="mf-mv__overlay" aria-hidden="true">
    <picture>
      <source
        media="(max-width: 767px)"
        srcset="/mock_site/MELIAFITNESS/images/mv-overlay-sp.webp"
      />
      <img
        src="/mock_site/MELIAFITNESS/images/mv-overlay.webp"
        alt=""
        aria-hidden="true"
      />
    </picture>
  </div>

  <!-- Copy -->
  <div class="mf-mv__content">
    <h1 class="mf-mv__copy">
      <span class="mf-mv__copy-line1">
        <span class="c-week">週一</span><span class="c-training">のトレーニング</span><span class="c-de">で</span>
      </span>
      <span class="mf-mv__copy-line2">
        <span class="c-body1">人に見せたくなる</span><span class="c-body23"><span class="c-body2">カラダ</span><span class="c-small">をつくる</span><span class="c-period">。</span></span>
      </span>
    </h1>
    <p class="mf-mv__sub">一流俳優・モデルを指導してきた<br class="sp-only" />本物のパーソナルトレーニング</p>
  </div>
</section>
