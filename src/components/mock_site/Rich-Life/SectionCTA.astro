<section class="rl-cta">
  <div class="rl-cta__outer">
    <div class="rl-cta__box">
      <div class="rl-cta__contents">
        <div class="rl-cta__copy-wrap">
          <div class="rl-cta__tag">今だけ</div>
          <div class="rl-cta__copy">
            <p class="rl-cta__copy-line">高品質でセンスのいい家具・家電を</p>
            <p class="rl-cta__copy-line rl-cta__copy-line--large">
              <span class="rl-cta__off">10%OFF</span>価格で<br class="sp-only" />レンタルできます。
            </p>
          </div>
          <ul class="rl-cta__merits">
            <li class="rl-cta__merit">月額440円〜</li>
            <li class="rl-cta__merit">1ヶ月〜レンタル可能</li>
            <li class="rl-cta__merit">長期レンタル割引あり</li>
          </ul>
        </div>
        <div class="rl-cta__btn-wrap">
          <div class="rl-cta__step-group">
            <div class="rl-cta__step">カンタン！ 3 STEP</div>
            <img src="/mock_site/Rich-Life/images/icon-polygon.svg" alt="" class="rl-cta__step-arrow" loading="lazy" decoding="async" />
          </div>
          <a href="#" class="rl-cta__btn">
            今すぐ会員登録
            <img src="/mock_site/Rich-Life/images/icon-arrow.svg" alt="" width="24" height="24" loading="lazy" decoding="async" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
