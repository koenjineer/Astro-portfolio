---
interface SocialLink {
  href: string;
  label: string;
  external: boolean;
}

interface TechItem {
  desc: string;
  name: string;
  icon: string;
  alt: string;
}

const currentYear = new Date().getFullYear();

const socialLinks: SocialLink[] = [
  {
    href: "https://github.com/koenjineer",
    label: "GitHub",
    external: true,
  },
  {
    href: "https://x.com/hiro_engineerJp",
    label: "X",
    external: true,
  },
  {
    href: "https://zenn.dev/koenjineer",
    label: "Zenn",
    external: true,
  },
  {
    href: "mailto:contact@hiroyuki-chuman.com",
    label: "Email",
    external: false,
  },
];

const techStack: TechItem[] = [
  { desc: "制作ツール：", name: "Astro", icon: "/svg/astro.svg", alt: "Astro" },
  {
    desc: "スタイル：",
    name: "TailwindCSS",
    icon: "/svg/tailwindcss.svg",
    alt: "TailwindCSS",
  },
  {
    desc: "ホスティング：",
    name: "Vercel",
    icon: "/svg/vercel.svg",
    alt: "Vercel",
  },
];
---

<footer class="w-full py-8 md:py-12 border-t border-[var(--white-icon-tr)]">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10">
      <div class="flex flex-col lg:items-start items-center gap-9">
        <div class="flex gap-6 sm:gap-8">
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                class="text-[var(--white-icon)] hover:text-[var(--white)] transition duration-300 ease-in-out"
                aria-label={link.label}
                {...(link.external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
              >
                {link.label === "GitHub" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="size-8"
                    aria-hidden="true"
                  >
                    <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z" />
                  </svg>
                )}
                {link.label === "X" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="size-8"
                    aria-hidden="true"
                  >
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                  </svg>
                )}
                {link.label === "Zenn" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="size-8"
                    aria-hidden="true"
                  >
                    <path d="M.264 23.771h4.984c.264 0 .498-.147.645-.352L19.614.874c.176-.293-.029-.645-.381-.645h-4.72c-.235 0-.44.117-.557.323L.03 23.361c-.088.176.029.41.234.41M17.445 23.419l6.479-10.408c.205-.323-.029-.733-.41-.733h-4.691c-.176 0-.352.088-.44.235l-6.655 10.643c-.176.264.029.616.352.616h4.779c.234-.029.468-.147.586-.353" />
                  </svg>
                )}
                {link.label === "Email" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="size-8"
                    aria-hidden="true"
                  >
                    <path d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col items-center">
        <div class="grid grid-cols-1 gap-3 w-full max-w-xs py-4 md:py-6">
          {
            techStack.map((tech) => (
              <div class="flex items-center justify-center lg:justify-normal gap-3">
                <span class="text-[var(--white-icon)] text-sm">
                  {tech.desc}
                </span>
                <img
                  src={tech.icon}
                  alt={tech.alt}
                  width="20"
                  height="20"
                  class="h-5 w-5 object-contain filter brightness-0 opacity-40"
                  loading="lazy"
                  decoding="async"
                />
                <span class="text-[var(--white-icon)] text-sm">
                  {tech.name}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="mt-8 md:mt-12 pt-6 md:pt-8 border-t border-[var(--white-icon-tr)]"
    >
      <p class="text-center text-sm text-[var(--white-icon)]">
        Copyright © {currentYear}
        <a
          href="https://github.com/koenjineer"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--white)] transition-colors duration-300"
          >Hiroyuki Chuman</a
        >. All rights reserved.
      </p>
    </div>
  </div>
</footer>
