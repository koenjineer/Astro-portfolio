// 背景: $color-base-blue / ガイドセクション5項目
---

<section class="sp-guide" id="guide">

  <div class="sp-guide__title-wrap sp-fade">
    <img class="sp-guide__title-deco" src="/mock_site/suisopot/images/title-deco-left.webp" alt="" aria-hidden="true" width="33" height="53" loading="lazy" />
    <h2 class="sp-guide__title">ご利用ガイド</h2>
    <img class="sp-guide__title-deco" src="/mock_site/suisopot/images/title-deco-right.webp" alt="" aria-hidden="true" width="33" height="53" loading="lazy" />
  </div>

  <div class="sp-guide__body sp-fade">

    <!-- 料金について -->
    <div class="sp-guide__section">
      <div class="sp-guide__section-head">
        <img class="sp-guide__bullet" src="/mock_site/suisopot/images/guide-bullet.svg" alt="" aria-hidden="true" width="20" height="20" />
        <p class="sp-guide__section-title">料金について</p>
      </div>
      <p class="sp-guide__text">SUISOPOT（スイソポット）のご利用には以下の料金がかかります。</p>
      <ul class="sp-guide__price-list">
        <li class="sp-guide__price-row">・初期手数料　5,000円</li>
        <li class="sp-guide__price-row">・月額利用料　3,800円</li>
      </ul>
    </div>

    <!-- 送料について -->
    <div class="sp-guide__section">
      <div class="sp-guide__section-head">
        <img class="sp-guide__bullet" src="/mock_site/suisopot/images/guide-bullet.svg" alt="" aria-hidden="true" width="20" height="20" />
        <p class="sp-guide__section-title">送料について</p>
      </div>
      <p class="sp-guide__text">生成器本体、ミネラルプレートのお届け時の送料は無料です。</p>
    </div>

    <!-- 配送方法について -->
    <div class="sp-guide__section">
      <div class="sp-guide__section-head">
        <img class="sp-guide__bullet" src="/mock_site/suisopot/images/guide-bullet.svg" alt="" aria-hidden="true" width="20" height="20" />
        <p class="sp-guide__section-title">配送方法について</p>
      </div>
      <p class="sp-guide__text">
        ご注文いただきました製品は、ヤマト運輸での発送とさせて頂いております。<br />
        通常、お申込みから1〜3営業日以内に製品出荷をいたします。交通状況や天候によってはご到着が遅れる場合もありますのでご了承くださいませ。
      </p>
    </div>

    <!-- お支払い方法について -->
    <div class="sp-guide__section">
      <div class="sp-guide__section-head">
        <img class="sp-guide__bullet" src="/mock_site/suisopot/images/guide-bullet.svg" alt="" aria-hidden="true" width="20" height="20" />
        <p class="sp-guide__section-title">お支払い方法について</p>
      </div>
      <p class="sp-guide__text">
        インターネットからお申し込みの場合、「クレジットカード決済」のみとさせていただいております。<br />
        銀行口座引き落としを希望される場合は、お電話での受付となりますので営業時間内に下記までご連絡ください。
      </p>
    </div>

    <!-- カスタマーセンター連絡先（Figmaでは body の独立 flex アイテム） -->
    <div class="sp-guide__contact">
      <p class="sp-guide__contact-line">カスタマーセンター</p>
      <p class="sp-guide__contact-line">TEL：03-1234-5678</p>
      <p class="sp-guide__contact-line">営業時間 9：00〜17：00 （平日のみ）</p>
    </div>

    <!-- 解約・交換について -->
    <div class="sp-guide__section">
      <div class="sp-guide__section-head">
        <img class="sp-guide__bullet" src="/mock_site/suisopot/images/guide-bullet.svg" alt="" aria-hidden="true" width="20" height="20" />
        <p class="sp-guide__section-title">解約・交換について</p>
      </div>
      <div class="sp-guide__text">
        <p class="sp-guide__sub-heading">・解約について</p>
        <p>
          ご契約中でも、途中解約はご自由に行うことができます。解約をご希望される場合は、カスタマーセンターにご連絡ください。<br />
          解約手数料は不要です。解約ご希望日の1ヶ月前迄に解約申請をお願いします。
        </p>
        <p class="sp-guide__sub-heading">・交換について</p>
        <p>万が一商品に不具合が発生した場合は、製品到着後速やかにカスタマーセンターにご連絡ください。</p>
        <p class="sp-guide__note">
          ※製品をお送りいただく送料につきましては、製品の瑕疵がある場合は当社が負担しますが、お客様のご都合による交換の場合は、お客様のご負担となります。
        </p>
      </div>
    </div>

  </div>

</section>
