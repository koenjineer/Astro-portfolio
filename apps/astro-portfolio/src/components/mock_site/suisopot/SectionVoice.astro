---

<section class="sp-voice" id="voice">

  <div class="sp-voice__title-wrap sp-fade">
    <img class="sp-voice__title-deco" src="/mock_site/suisopot/images/title-deco-left.webp" alt="" aria-hidden="true" width="33" height="53" loading="lazy" />
    <h2 class="sp-voice__title">お客様の声</h2>
    <img class="sp-voice__title-deco" src="/mock_site/suisopot/images/title-deco-right.webp" alt="" aria-hidden="true" width="33" height="53" loading="lazy" />
  </div>

  <div class="sp-voice__slider sp-fade">
    <button class="sp-voice__arrow sp-voice__arrow--prev" type="button" aria-label="前へ">
      <img src="/mock_site/suisopot/images/use-arrow.svg" alt="" aria-hidden="true" width="29" height="29" />
    </button>

    <div class="swiper sp-voice__swiper">
      <ul class="swiper-wrapper sp-voice__list">
        {voices.map((v) => (
          <li class="swiper-slide sp-voice__item">
            <div class="sp-voice__photo">
              <img
                src={`/mock_site/suisopot/images/${v.src}`}
                alt={v.alt}
                width="320"
                height="225"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="sp-voice__body">
              <p class:list={['sp-voice__heading', v.compact && 'sp-voice__heading--compact']}>{v.heading}</p>
              <p class="sp-voice__text">{v.body}</p>
              <div class="sp-voice__meta">
                <p class="sp-voice__name">{v.name}</p>
                <img
                  class="sp-voice__btn"
                  src="/mock_site/suisopot/images/voice-btn.svg"
                  alt=""
                  aria-hidden="true"
                  width="22"
                  height="22"
                />
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <button class="sp-voice__arrow sp-voice__arrow--next" type="button" aria-label="次へ">
      <img src="/mock_site/suisopot/images/use-arrow.svg" alt="" aria-hidden="true" width="29" height="29" />
    </button>
  </div>

  <div class="sp-voice__dots">
    {voices.map((v, i) => (
      <button class:list={['sp-voice__dot', i === 0 && 'sp-voice__dot--active']} type="button" aria-label={`${i + 1}件目の声へ`}></button>
    ))}
  </div>

</section>

<script is:inline>
  (function () {
    function initVoiceSwiper() {
      if (typeof Swiper === 'undefined') return;
      var dots = document.querySelectorAll('.sp-voice__dot');
      var swiper = new Swiper('.sp-voice__swiper', {
        slidesPerView: 3,
        spaceBetween: 16,
        // 端に着いても止まらず続ける。複製スライドが出るので、ドットは realIndex で扱う
        loop: true,
        navigation: {
          nextEl: '.sp-voice__arrow--next',
          prevEl: '.sp-voice__arrow--prev',
        },
        breakpoints: {
          // SPはカード幅236px固定（Figma 1:2943 / 1:1824）= コンテナ幅なので1枚表示。
          // 'auto' + loop は複製スライドが作られず、端で動かなくなるため使わない
          0: {
            slidesPerView: 1,
            spaceBetween: 16,
          },
          768: {
            slidesPerView: 3,
            spaceBetween: 16,
          },
        },
        on: {
          init: updateDots,
          realIndexChange: updateDots,
        },
      });

      // PCは3枚表示でスナップ位置が減るが、カンプは9枚=9ドットなので自前で描画する
      dots.forEach(function (dot, index) {
        dot.addEventListener('click', function () {
          swiper.slideToLoop(index);
        });
      });

      function updateDots(instance) {
        dots.forEach(function (dot, index) {
          dot.classList.toggle('sp-voice__dot--active', index === instance.realIndex);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVoiceSwiper);
    } else {
      initVoiceSwiper();
    }
  })();
</script>
