---
const navItems = [
  { href: "#about", label: "About" },
  { href: "#menu", label: "Menu" },
  { href: "#shop", label: "Shop" },
  { href: "#contact", label: "Contact" },
];

const snsItems = [
  {
    href: "https://twitter.com/",
    label: "Twitter",
    img: "/mock_site/GardenSalad/images/sns-twitter.webp",
  },
  {
    href: "https://www.instagram.com/",
    label: "Instagram",
    img: "/mock_site/GardenSalad/images/sns-instagram.webp",
  },
  {
    href: "https://www.tiktok.com/",
    label: "TikTok",
    img: "/mock_site/GardenSalad/images/sns-tiktok.webp",
  },
];
---

<footer class="gs-footer">
  <div class="gs-footer__inner">
    <!-- SNS -->
    <ul class="gs-footer__sns" aria-label="ソーシャルメディア">
      {
        snsItems.map(({ href, label, img }) => (
          <li>
            <a
              href={href}
              class="gs-footer__sns-btn"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label}
            >
              <img src={img} alt="" width="80" height="80" loading="lazy" />
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Nav -->
    <nav class="gs-footer__nav" aria-label="フッターナビゲーション">
      {navItems.map(({ href, label }) => <a href={href}>{label}</a>)}
    </nav>

    <!-- Logo -->
    <!-- Figma: 166×90px、ドーム色=#333(ダーク)、Garden/TF=#333、Salad=green -->
    <div class="gs-footer__logo">
      <a href="#" aria-label="TF Garden Salad トップへ">
        <div class="gs-footer__logo-wrap">
          <!-- ダーク塗りのドーム（下半分） -->
          <div class="gs-footer__logo-dome" aria-hidden="true"></div>
          <span class="gs-footer__logo-tf">TF</span>
          <span class="gs-footer__logo-garden">Garden</span>
          <span class="gs-footer__logo-salad">Salad</span>
        </div>
      </a>
    </div>

    <!-- Copyright -->
    <p class="gs-footer__copyright">©︎ TF Garden Salad</p>
  </div>
</footer>
