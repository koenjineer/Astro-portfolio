<figure class="mf-gym">
  <picture>
    <source
      media="(max-width: 767px)"
      srcset="/mock_site/MELIAFITNESS/images/gym-sp.webp"
    />
    <img
      src="/mock_site/MELIAFITNESS/images/gym-pc.webp"
      alt="MELIA FITNESSのジム"
      loading="lazy"
    />
  </picture>
</figure>

<style>
  .mf-gym {
    width: 100%;
    height: 400px;
    overflow: hidden;
    margin: 0;

    picture,
    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
  }

  @media (max-width: 767px) {
