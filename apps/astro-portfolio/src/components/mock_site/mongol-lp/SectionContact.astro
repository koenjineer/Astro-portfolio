---
---

<section class="ml-contact">

  <div class="ml-contact__heading ml-section-hdg">
    <div class="ml-section-hdg__deco">
      <img src="/mock_site/mongol-lp/images/section-pattern.webp" alt="" aria-hidden="true" width="35" height="46" loading="lazy" />
      <img src="/mock_site/mongol-lp/images/section-design1.webp" alt="" aria-hidden="true" width="35" height="46" loading="lazy" />
      <img src="/mock_site/mongol-lp/images/section-pattern.webp" alt="" aria-hidden="true" width="35" height="46" loading="lazy" />
    </div>
    <h2 class="ml-section-hdg__text">お問い合わせ</h2>
    <div class="ml-section-hdg__deco">
      <img src="/mock_site/mongol-lp/images/section-design1.webp" alt="" aria-hidden="true" width="35" height="46" loading="lazy" />
      <img src="/mock_site/mongol-lp/images/section-pattern.webp" alt="" aria-hidden="true" width="35" height="46" loading="lazy" />
      <img src="/mock_site/mongol-lp/images/section-pattern.webp" alt="" aria-hidden="true" width="35" height="46" loading="lazy" />
    </div>
  </div>

  <div class="ml-contact__inner">
    <form class="ml-contact__form" action="#" method="post" novalidate>

      <div class="ml-contact__form-row">
        <div class="ml-contact__form-label">
          <label class="ml-contact__label" for="contact-name">お名前</label>
          <span class="ml-contact__required">必須</span>
        </div>
        <input class="ml-contact__input" type="text" id="contact-name" name="name" placeholder="フルネームでご入力ください" required />
      </div>

      <div class="ml-contact__form-row">
        <div class="ml-contact__form-label">
          <label class="ml-contact__label" for="contact-email">メールアドレス</label>
          <span class="ml-contact__required">必須</span>
        </div>
        <input class="ml-contact__input" type="email" id="contact-email" name="email" placeholder="mail@example.com" required />
      </div>

      <div class="ml-contact__form-row">
        <div class="ml-contact__form-label">
          <label class="ml-contact__label" for="contact-phone">電話番号</label>
        </div>
        <input class="ml-contact__input" type="tel" id="contact-phone" name="phone" />
      </div>

      <div class="ml-contact__form-row ml-contact__form-row--radio">
        <div class="ml-contact__form-label">
          <p class="ml-contact__label">お問い合わせ内容</p>
        </div>
        <div class="ml-contact__radios">
          <label class="ml-contact__radio-item">
            <input type="radio" name="inquiry" value="reserve" />
            <span>予約したい</span>
          </label>
          <label class="ml-contact__radio-item">
            <input type="radio" name="inquiry" value="question" />
            <span>質問したい</span>
          </label>
          <label class="ml-contact__radio-item">
            <input type="radio" name="inquiry" value="other" />
            <span>その他</span>
          </label>
        </div>
      </div>

      <div class="ml-contact__form-row ml-contact__form-row--check">
        <div class="ml-contact__form-label">
          <p class="ml-contact__label">モンゴルでやってみたいこと</p>
          <span class="ml-contact__note">（複数選択可）</span>
        </div>
        <div class="ml-contact__checks">
          <label class="ml-contact__check-item">
            <input type="checkbox" name="activity" value="balloon" />
            <span>気球</span>
          </label>
          <label class="ml-contact__check-item">
            <input type="checkbox" name="activity" value="horse" />
            <span>乗馬</span>
          </label>
          <label class="ml-contact__check-item">
            <input type="checkbox" name="activity" value="river" />
            <span>川下り</span>
          </label>
          <label class="ml-contact__check-item">
            <input type="checkbox" name="activity" value="ruins" />
            <span>遺跡観光</span>
          </label>
          <label class="ml-contact__check-item">
            <input type="checkbox" name="activity" value="nomad" />
            <span>遊牧民体験・家訪問</span>
          </label>
        </div>
      </div>

      <div class="ml-contact__form-row ml-contact__form-row--textarea">
        <div class="ml-contact__form-label">
          <label class="ml-contact__label" for="contact-message">メッセージ本文</label>
        </div>
        <textarea class="ml-contact__textarea" id="contact-message" name="message" rows="6"></textarea>
      </div>

      <div class="ml-contact__submit-wrap">
        <button class="ml-contact__submit" type="submit">送信する</button>
      </div>

    </form>

    <div class="ml-contact__cards">
      <div class="ml-contact__card">
        <div class="ml-contact__card-icon" aria-hidden="true">
          <img src="/mock_site/mongol-lp/images/footer-arrow.svg" alt="" width="36" height="36" loading="lazy" />
        </div>
        <p class="ml-contact__card-label">お電話でのお問い合わせ</p>
        <p class="ml-contact__card-value">050-XXXX-XXXX</p>
        <p class="ml-contact__card-sub">（担当：長野）</p>
      </div>
      <div class="ml-contact__card">
        <div class="ml-contact__card-icon" aria-hidden="true">
          <img src="/mock_site/mongol-lp/images/footer-arrow.svg" alt="" width="36" height="36" loading="lazy" />
        </div>
        <p class="ml-contact__card-label">メールでのお問い合わせ</p>
        <p class="ml-contact__card-value">info@example.com</p>
      </div>
    </div>

    <p class="ml-contact__ssl">お客様の個人情報を守るため、信頼できるサイトの証として、当サイトは全てのページにSSL暗号化通信を導入しています。送信の内容が第三者に盗み見られる心配はございません。</p>
  </div>

</section>
