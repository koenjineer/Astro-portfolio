<section id="contact" class="w-full py-12 border-t border-[var(--white-icon-tr)]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Let's talk</h2>
    <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-6">
      Contact
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="text-[var(--white-icon)]">
        <p class="mb-4">
          コーディングの代行や、Web制作のパートナーをお探しですか？<br
          />デザインの意図を汲み取った丁寧な実装を心がけています。<br
          />まずはお気軽にご相談ください。
        </p>
        <div class="flex items-center gap-2">
          <span>Location:</span>
          <span class="text-[var(--white)]">Tokyo, Japan</span>
        </div>
        <div
          id="contact-video-wrap"
          class="hidden md:block w-fit mt-6 h-[206px] rounded-2xl overflow-hidden border border-[var(--white-icon-tr)]"
        >
          <video
            id="contact-video"
            muted
            playsinline
            preload="none"
            width="640"
            height="360"
            class="h-full w-auto block"
          ></video>
        </div>
      </div>

      <div>
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="flex flex-col gap-4"
        >
          <input type="hidden" name="access_key" value="754d6aa3-98aa-4421-88bc-b768cf7d46f7" />
          <input
            type="text"
            name="from_name"
            placeholder="お名前（会社名）"
            required
            class="px-4 py-2 bg-white text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <input
            type="email"
            name="reply_to"
            placeholder="メールアドレス"
            required
            class="px-4 py-2 bg-white text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <textarea
            name="message"
            placeholder="ご相談内容"
            rows="6"
            required
            class="px-4 py-2 bg-white text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] resize-none"
          ></textarea>
          <button
            type="submit"
            id="submit-btn"
            class="px-4 py-3 bg-[var(--sec)] text-white font-medium rounded-lg transition-all duration-200 hover:bg-blue-600 active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed"
          >
            送信する
          </button>
        </form>
        <div
          id="form-success"
          class="hidden flex-col items-center gap-2 mt-4 p-4 bg-blue-50 border border-blue-200 rounded-lg text-center"
        >
          <span class="text-2xl">✅</span>
          <p class="text-[var(--white)] font-medium">お問い合わせありがとうございます。</p>
          <p class="text-[var(--white-icon)] text-sm">内容を確認次第、返信いたします。</p>
        </div>
        <div
          id="form-error"
          class="hidden flex-col items-center gap-2 mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-center"
        >
          <span class="text-2xl">⚠️</span>
          <p class="text-[var(--white)] font-medium">送信に失敗しました。</p>
          <p class="text-[var(--white-icon)] text-sm">時間をおいて再度お試しいただくか、直接メールにてご連絡ください。</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module" is:inline>
  const contactVideo = document.getElementById("contact-video");
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (contactVideo) {
    if (reducedMotion) {
      contactVideo.controls = true;
    } else {
      contactVideo.playbackRate = 0.7;
    }
    let loaded = false;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting || reducedMotion) continue;
          if (!loaded) {
            contactVideo.src = "/videos/contact-ambient.mp4";
            loaded = true;
          }
          contactVideo.currentTime = 0;
          contactVideo.play().catch(() => {});
        }
      },
      { threshold: 0.5 },
    );
    observer.observe(contactVideo);
  }

  const form = document.getElementById("contact-form");
  const submitBtn = document.getElementById("submit-btn");
  const formSuccess = document.getElementById("form-success");
  const formError = document.getElementById("form-error");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = "送信中...";

    const formData = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: formData,
        headers: { Accept: "application/json" },
      });
      const data = await response.json();

      if (data.success) {
        form.style.display = "none";
        formSuccess.style.display = "flex";
      } else {
        submitBtn.disabled = false;
        submitBtn.textContent = "送信する";
        formError.style.display = "flex";
      }
    } catch (error) {
      submitBtn.disabled = false;
      submitBtn.textContent = "送信する";
      formError.style.display = "flex";
    }
  });
</script>
