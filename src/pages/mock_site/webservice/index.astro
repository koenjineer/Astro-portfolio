---
import Layout from "@/layouts/mock_site/webservice/Layout.astro";
import Header from "@components/mock_site/webservice/Header.astro";
import FirstView from "@components/mock_site/webservice/FirstView.astro";
import About from "@components/mock_site/webservice/About.astro";
import Feature from "@components/mock_site/webservice/Feature.astro";
import Cta from "@components/mock_site/webservice/Cta.astro";
import Users from "@components/mock_site/webservice/Users.astro";
import Flow from "@components/mock_site/webservice/Flow.astro";
import Price from "@components/mock_site/webservice/Price.astro";
import Question from "@components/mock_site/webservice/Question.astro";
import Footer from "@components/mock_site/webservice/Footer.astro";

const title = "Ravek - タスク管理ツール";
const description =
  "Ravek（レイベック）は複数人のプロジェクトにおけるタスク管理を簡単かつ高速にし、生産性を向上させるツールです。";
---

<Layout {title} {description}>
  <Header />
  <main>
    <FirstView />
    <About />
    <Feature />
    <Cta />
    <Users />
    <Flow />
    <Cta />
    <Price />
    <Question />
    <Cta />
  </main>
  <Footer />
</Layout>
