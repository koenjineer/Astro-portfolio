---
const technologies = [
  "astro",
  "react",
  "typeScript",
  "HTML5",
  "CSS3",
  "javaScript",
  "sass",
  "git",
  "wordpress",
  "figma",
  "github",
  "claudeCode",
  "chatGPT",
  "cursor",
  "tailwindcss",
  // "nodejs",
  "next",
  // "vue",
  // "supabase",
  // "mysql",
  // "bash",
];

// 黒っぽいロゴ。ダークモードの地に沈むので、ダークのときだけ明るく反転させる
const darkInvertLogos = new Set(["astro", "github", "chatGPT", "cursor", "next"]);

const labelOverrides: Record<string, string> = {
  claudeCode: "Claude Code",
};

function label(tech: string) {
  return labelOverrides[tech] ?? tech.charAt(0).toUpperCase() + tech.slice(1);
}
---

<div class="relative overflow-x-hidden py-8">
  <div
    class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-[var(--background)] to-transparent z-20"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-[var(--background)] to-transparent z-20"
  >
  </div>

  <div class="flex animate-scroll w-max will-change-transform">
    {
      [...technologies, ...technologies].map((tech, index) => (
        <div
          class="flex items-center gap-2 pr-12 md:pr-20 group transition-all duration-300"
          aria-hidden={index >= technologies.length ? "true" : "false"}
        >
          <img
            src={`/svg/${tech}.svg`}
            alt={tech}
            class="h-7 w-auto object-contain transition-transform group-hover:scale-110"
            width="30"
            height="30"
            loading={index < technologies.length ? "eager" : "lazy"}
            decoding="async"
            data-dark-invert={darkInvertLogos.has(tech) ? "" : undefined}
          />
          <span class="text-lg font-medium text-[var(--white)] whitespace-nowrap">
            {label(tech)}
          </span>
        </div>
      ))
    }
  </div>
</div>

<style is:global>
  @keyframes scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }
  .animate-scroll {
    animation: scroll 60s linear infinite;
  }

  /* 反転したあと色相を半周戻すと、黒は白に、Astro のオレンジはオレンジのまま残る */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) [data-dark-invert] {
      filter: invert(1) hue-rotate(180deg);
    }
  }

  :root[data-theme="dark"] [data-dark-invert] {
    filter: invert(1) hue-rotate(180deg);
  }

  @media (min-width: 768px) {
    .animate-scroll {
      animation-duration: 50s;
    }
  }
</style>
