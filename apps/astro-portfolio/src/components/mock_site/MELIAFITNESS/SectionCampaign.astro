---
---

<section class="mf-campaign" id="campaign" aria-labelledby="mf-campaign-heading">
  <!-- Background -->
  <div class="mf-campaign__bg" aria-hidden="true">
    <picture>
      <source
        media="(max-width: 767px)"
        srcset="/mock_site/MELIAFITNESS/images/campaign-bg-sp.webp"
      />
      <img
        src="/mock_site/MELIAFITNESS/images/campaign-bg.webp"
        alt=""
        loading="lazy"
      />
    </picture>
  </div>
  <div class="mf-campaign__overlay" aria-hidden="true"></div>

  <!-- Box -->
  <div class="mf-campaign__box mf-reveal">

    <!-- Title area with deco lines -->
    <div class="mf-campaign__title-area">
      <img
        class="mf-campaign__deco"
        src="/mock_site/MELIAFITNESS/images/campaign-title-deco.webp"
        alt=""
        aria-hidden="true"
      />
      <h2 class="mf-campaign__heading" id="mf-campaign-heading">
        期間限定無料体験キャンペーン
      </h2>
    </div>

    <!-- Price area: left / arrow / right -->
    <div class="mf-campaign__price-area">

      <!-- Left: course + original price -->
      <div class="mf-campaign__left">
        <p class="mf-campaign__course">体験コース　1回60分</p>
        <p class="mf-campaign__original-label">通常価格</p>
        <p class="mf-campaign__original">
          <span>¥12,00</span><span class="t0">0</span><span class="tax">税込</span>
        </p>
      </div>

      <!-- Center: >> arrow -->
      <div class="mf-campaign__arrow" aria-hidden="true">
        <img
          src="/mock_site/MELIAFITNESS/images/campaign-yen-icon.webp"
          alt=""
          loading="lazy"
        />
      </div>

      <!-- Right: 先着 badge + ¥０ -->
      <div class="mf-campaign__right">
        <div class="mf-campaign__limit">
          <img
            src="/mock_site/MELIAFITNESS/images/campaign-frame.webp"
            alt=""
            loading="lazy"
          />
          <span>先着10名様限定</span>
        </div>
        <div class="mf-campaign__price">
          <span class="mf-campaign__yen">￥</span>
          <span class="mf-campaign__price-num">０</span>
        </div>
      </div>
    </div>

    <!-- Period -->
    <div class="mf-campaign__period">
      <span class="mf-campaign__period-label">キャンペーン期間</span>
      <span class="mf-campaign__period-date">12月1日（月）～12月30日（金）</span>
    </div>

    <!-- CTA Button -->
    <a href="#" class="mf-campaign__btn" aria-label="LINEで予約する">
      <span>２分で完了！LINEで予約する</span>
      <img
        class="mf-campaign__btn-arrow"
        src="/mock_site/MELIAFITNESS/images/campaign-arrow.webp"
        alt=""
        aria-hidden="true"
        loading="lazy"
      />
    </a>
  </div>
</section>
