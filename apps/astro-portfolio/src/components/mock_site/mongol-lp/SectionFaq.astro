---
---

<section class="ml-faq">
  <div class="ml-faq__deco ml-faq__deco--left" aria-hidden="true">
    <img src="/mock_site/mongol-lp/images/qa-deco.webp" alt="" width="125" height="162" loading="lazy" />
  </div>
  <div class="ml-faq__deco ml-faq__deco--right" aria-hidden="true">
    <img src="/mock_site/mongol-lp/images/qa-flower.webp" alt="" width="125" height="162" loading="lazy" />
  </div>

  <div class="ml-faq__heading ml-section-hdg">
    <div class="ml-section-hdg__deco">
      <img src="/mock_site/mongol-lp/images/section-pattern.webp" alt="" aria-hidden="true" width="35" height="46" loading="lazy" />
      <img src="/mock_site/mongol-lp/images/section-design1.webp" alt="" aria-hidden="true" width="35" height="46" loading="lazy" />
      <img src="/mock_site/mongol-lp/images/section-pattern.webp" alt="" aria-hidden="true" width="35" height="46" loading="lazy" />
    </div>
    <h2 class="ml-section-hdg__text">よくある質問</h2>
    <div class="ml-section-hdg__deco">
      <img src="/mock_site/mongol-lp/images/section-design1.webp" alt="" aria-hidden="true" width="35" height="46" loading="lazy" />
      <img src="/mock_site/mongol-lp/images/section-pattern.webp" alt="" aria-hidden="true" width="35" height="46" loading="lazy" />
      <img src="/mock_site/mongol-lp/images/section-pattern.webp" alt="" aria-hidden="true" width="35" height="46" loading="lazy" />
    </div>
  </div>

  <div class="ml-faq__inner">
    <details class="ml-faq__item" open>
      <summary class="ml-faq__question">
        <div class="ml-faq__q-icon">
          <img src="/mock_site/mongol-lp/images/qa-circle-q.svg" alt="Q" width="37" height="37" />
        </div>
        <span class="ml-faq__q-text">ツアー代金に飛行機代は含まれますか？</span>
        <div class="ml-faq__chevron" aria-hidden="true">
          <img src="/mock_site/mongol-lp/images/qa-chevron.svg" alt="" width="18" height="18" />
        </div>
      </summary>
      <div class="ml-faq__answer">
        <div class="ml-faq__a-icon">
          <img src="/mock_site/mongol-lp/images/qa-circle-a.svg" alt="A" width="37" height="37" />
        </div>
        <p class="ml-faq__a-text">含まれません。お手数ですが、ご自身で航空券の手配をお願いします。ご希望であればチケット手配会社のご紹介も可能です。</p>
      </div>
    </details>

    <details class="ml-faq__item">
      <summary class="ml-faq__question">
        <div class="ml-faq__q-icon">
          <img src="/mock_site/mongol-lp/images/qa-circle-q.svg" alt="Q" width="37" height="37" />
        </div>
        <span class="ml-faq__q-text">現地で日本語は通じますか？</span>
        <div class="ml-faq__chevron" aria-hidden="true">
          <img src="/mock_site/mongol-lp/images/qa-chevron.svg" alt="" width="18" height="18" />
        </div>
      </summary>
      <div class="ml-faq__answer">
        <div class="ml-faq__a-icon">
          <img src="/mock_site/mongol-lp/images/qa-circle-a.svg" alt="A" width="37" height="37" />
        </div>
        <p class="ml-faq__a-text">キャンプスタッフや日本語ガイドが対応いたします。安心してご旅行ください。</p>
      </div>
    </details>

    <details class="ml-faq__item">
      <summary class="ml-faq__question">
        <div class="ml-faq__q-icon">
          <img src="/mock_site/mongol-lp/images/qa-circle-q.svg" alt="Q" width="37" height="37" />
        </div>
        <span class="ml-faq__q-text">モンゴル旅行の服装は？</span>
        <div class="ml-faq__chevron" aria-hidden="true">
          <img src="/mock_site/mongol-lp/images/qa-chevron.svg" alt="" width="18" height="18" />
        </div>
      </summary>
      <div class="ml-faq__answer">
        <div class="ml-faq__a-icon">
          <img src="/mock_site/mongol-lp/images/qa-circle-a.svg" alt="A" width="37" height="37" />
        </div>
        <p class="ml-faq__a-text">夏でも朝晩は冷え込みますので、重ね着できる服装をお持ちください。長袖・長ズボンをおすすめします。</p>
      </div>
    </details>

    <details class="ml-faq__item">
      <summary class="ml-faq__question">
        <div class="ml-faq__q-icon">
          <img src="/mock_site/mongol-lp/images/qa-circle-q.svg" alt="Q" width="37" height="37" />
        </div>
        <span class="ml-faq__q-text">現地での支払いは？</span>
        <div class="ml-faq__chevron" aria-hidden="true">
          <img src="/mock_site/mongol-lp/images/qa-chevron.svg" alt="" width="18" height="18" />
        </div>
      </summary>
      <div class="ml-faq__answer">
        <div class="ml-faq__a-icon">
          <img src="/mock_site/mongol-lp/images/qa-circle-a.svg" alt="A" width="37" height="37" />
        </div>
        <p class="ml-faq__a-text">現地ではUSドルまたはモンゴルトゥグルグでのお支払いとなります。</p>
      </div>
    </details>
  </div>

  <div class="ml-faq__btn-wrap">
    <a href="#" class="ml-faq__btn">
      よくある質問一覧を見る
      <img src="/mock_site/mongol-lp/images/arrow.svg" alt="" aria-hidden="true" width="13" height="13" />
    </a>
  </div>
</section>
