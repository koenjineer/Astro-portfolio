---
---

<section class="gs-access" id="shop" aria-labelledby="gs-access-title">
  <div class="gs-access__title-wrap">
    <h2 class="gs-section-title gs-reveal" id="gs-access-title">
      <span class="gs-section-title__ja">店舗情報</span>
      <span class="gs-section-title__en">Shop</span>
      <span class="gs-section-title__line" aria-hidden="true"></span>
    </h2>
  </div>

  <!-- Google Map -->
  <div class="gs-access__map" role="img" aria-label="店舗周辺の地図">
    <img
      src="/mock_site/GardenSalad/images/map.webp"
      alt="店舗地図"
      width="2880"
      height="930"
      loading="lazy"
    />
    <!-- マップピン：ロゴ付き複合要素 -->
    <div class="gs-access__map-pin" aria-label="TF Garden Salad 店舗位置">
      <img
        src="/mock_site/GardenSalad/images/map-pin.webp"
        alt=""
        class="gs-access__map-pin-bg"
        width="150"
        loading="lazy"
      />
      <div class="gs-access__map-pin-logo" aria-hidden="true">
        <div class="gs-access__map-pin-logo-dome"></div>
        <span class="gs-access__map-pin-logo-tf">TF</span>
        <span class="gs-access__map-pin-logo-garden">Garden</span>
        <span class="gs-access__map-pin-logo-salad">Salad</span>
      </div>
    </div>
  </div>

  <!-- 店舗情報 -->
  <div class="gs-access__info-wrap">
    <div class="gs-access__store-info gs-reveal">
      <h3 class="gs-access__store-name">
        <span class="tf">TF</span>
        <span class="en">Garden Salad</span>
        <span class="ja">（ ガーデンサラダ ）</span>
      </h3>
      <p class="gs-access__address">
        〒150 - 0000<br />
        東京都渋谷区表参道 10 - 20 - 20<br />
        Tel. 090 - 1234 - 8899
      </p>
      <p class="gs-access__details">
        営業時間　11 : 00 - 20 : 00<br />
        定休日　　日曜<br />
        アクセス　東京メトロ千代田線「明治神宮前駅」<br />
        　　　　　5番出口から徒歩5分<br />
        　　　　　JR「原宿駅」東口から徒歩10分
      </p>
    </div>
    <div class="gs-access__exterior-img gs-reveal">
      <img
        src="/mock_site/GardenSalad/images/store-exterior.webp"
        alt="TF Garden Salad 店舗外観"
        width="1400"
        height="1000"
        loading="lazy"
      />
    </div>
  </div>

  <!-- ポストカード -->
  <div class="gs-postcard">
    <div class="gs-postcard__stamp">
      <img
        src="/mock_site/GardenSalad/images/stamp.webp"
        alt=""
        aria-hidden="true"
        width="576"
        height="480"
        loading="lazy"
      />
    </div>
    <div class="gs-postcard__card gs-reveal">
      <div class="gs-postcard__photos">
        <div class="gs-postcard__photo">
          <img
            src="/mock_site/GardenSalad/images/open-terrace.webp"
            alt="オープンテラス"
            width="1259"
            height="861"
            loading="lazy"
          />
        </div>
        <div class="gs-postcard__photo">
          <img
            src="/mock_site/GardenSalad/images/takeout.webp"
            alt="テイクアウト"
            width="899"
            height="861"
            loading="lazy"
          />
        </div>
      </div>
      <div class="gs-postcard__body">
        <!-- Figma: 3列レイアウト Dear You.(左) | 本文(中央) | Have a nice day!!(右) -->
        <p class="gs-postcard__dear">Dear You.</p>
        <div class="gs-postcard__message">
          <p class="gs-postcard__text">
            当店から徒歩5分ほどの場所に、オープンテラスの場所があります。お天気がいい日は、木漏れ日の中で風を感じながら食べるのもおすすめです。
          </p>
          <p class="gs-postcard__text">
            テイクアウトもご用意できるので、ぜひご利用ください。
          </p>
        </div>
        <div class="gs-postcard__nice-day">
          <span>Have a nice day !!</span>
        </div>
      </div>
    </div>
  </div>
</section>
