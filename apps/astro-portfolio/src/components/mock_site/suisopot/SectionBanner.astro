---
// セクション12: banner (Figma 113:2936 / SP 1:2740)
// Figma が絶対配置のため、バナー内（PC 1281×675 / SP 360×360）は固定寸法の座標で再現する
const tags = [
  { label: '送料無料', sub: '' },
  { label: '解約可能', sub: 'いつでも' },
  { label: '設置工事不要', sub: '' },
  { label: '無料', sub: 'ミネラルプレート' },
];
---

<section class="sp-banner" id="campaign" aria-label="新料金プランのご案内">
  <div class="sp-banner__card sp-fade">
    <img class="sp-banner__circle" src="/mock_site/suisopot/images/banner-date-circle.webp" alt="10/1 受付開始" width="302" height="302" loading="lazy" decoding="async" />
    <img class="sp-banner__product" src="/mock_site/suisopot/images/banner-product.webp" alt="SUISOPOT本体" width="212" height="371" loading="lazy" decoding="async" />

    <p class="sp-banner__catch">
      <span class="sp-banner__slash sp-banner__slash--left" aria-hidden="true"></span>
      <span>カラダにおいし<span class="sp-banner__kern" style="letter-spacing: -0.246em">い</span>「<span class="sp-banner__kern" style="letter-spacing: -0.14em">ナ</span><span class="sp-banner__kern" style="letter-spacing: -0.055em">ノ</span>バブル水素水<span class="sp-banner__kern" style="letter-spacing: -0.246em">」</span>が飲み放題</span>
      <span class="sp-banner__slash sp-banner__slash--right" aria-hidden="true"></span>
    </p>

    <p class="sp-banner__promo">ず——っと利用料金が<span class="sp-banner__promo-num">1,000</span>円引き</p>

    <h2 class="sp-banner__headline">新料金プラン登場</h2>

    <p class="sp-banner__normal-label">通常プラン</p>
    <p class="sp-banner__normal-price">¥4,800</p>
    <img class="sp-banner__strike" src="/mock_site/suisopot/images/banner-strike-sp.svg" alt="" aria-hidden="true" width="70" height="29" loading="lazy" />
    <img class="sp-banner__arrow" src="/mock_site/suisopot/images/banner-arrow.svg" alt="" aria-hidden="true" width="65" height="58" loading="lazy" />
    <p class="sp-banner__value-label">バリュープラン</p>
    <p class="sp-banner__value-price" data-text="¥3,800">¥3,800</p>
    <p class="sp-banner__tax">(税込)</p>

    <ul class="sp-banner__tags">
      {tags.map((tag) => (
        <li class="sp-banner__tag">
          {tag.sub && <span class="sp-banner__tag-sub">{tag.sub}</span>}
          <span class="sp-banner__tag-main">{tag.label}</span>
        </li>
      ))}
    </ul>

    <p class="sp-banner__note">初回は初期手数料 <span class="sp-banner__note-num">5,000</span>円が別途かかります</p>
  </div>
</section>
