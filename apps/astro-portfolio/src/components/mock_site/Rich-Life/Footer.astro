---
const navGroups = [
  {
    label: 'SERVICE',
    links: ['すべて', '家具', '家電', 'お知らせ', '商品の魅力・選び方記事'],
  },
  {
    label: 'ABOUT',
    links: ['会社概要', '採用情報'],
  },
  {
    label: 'SUPPORT',
    links: ['よくある質問', 'お問い合わせ(個人のお客様)', 'プライバシー', '利用規約', '法人会員向け利用規約', '特定商取引法に基づく表記'],
  },
  {
    label: 'CLAS BUSINESS',
    links: ['法人向けサービスについて', '手軽にためす', 'まとめておまかせ', '導入事例'],
  },
];
---
<footer class="rl-footer">
  <div class="rl-footer__inner">
    <nav aria-label="フッターナビゲーション" class="rl-footer__nav-grid">
      {navGroups.map(group => (
        <div class="rl-footer__nav-group">
          <div class="rl-footer__nav-head">
            <h2 class="rl-footer__nav-label">{group.label}</h2>
            <img src="/mock_site/Rich-Life/images/footer-line.svg" alt="" class="rl-footer__nav-line" loading="lazy" decoding="async" />
          </div>
          <ul class="rl-footer__nav-links">
            {group.links.map(link => (
              <li><a href="#" class="rl-footer__nav-link">{link}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <div class="rl-footer__sns">
      <a href="#" class="rl-footer__sns-link">
        <img src="/mock_site/Rich-Life/images/icon-instagram.svg" alt="Instagram" width="32" height="32" loading="lazy" decoding="async" />
      </a>
      <a href="#" class="rl-footer__sns-link">
        <img src="/mock_site/Rich-Life/images/icon-twitter.svg" alt="Twitter" width="32" height="32" loading="lazy" decoding="async" />
      </a>
      <a href="#" class="rl-footer__sns-link">
        <img src="/mock_site/Rich-Life/images/icon-facebook.svg" alt="Facebook" width="32" height="32" loading="lazy" decoding="async" />
      </a>
    </div>

    <div class="rl-footer__bottom">
      <p class="rl-footer__note">本サイト内は株式会社CLAS様のご協力のもと作成したコーディング用の練習課題です。実在の人物・団体とは関係ありません。</p>
      <p class="rl-footer__copy">©️ 2022 Rich-Life Inc.</p>
    </div>
  </div>
</footer>
